# --- Database ---
DATABASE_URL="postgresql://productos:productos@localhost:5432/productos?schema=public"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OIDC (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email magic link (optional)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="no-reply@example.com"

# Dev credentials provider (only honoured when NODE_ENV !== "production")
ALLOW_DEV_LOGIN="true"

# Preview credentials provider — allowlisted emails only.
# Comma-separated list of emails that may sign in via the "preview" provider
# even in production builds. Use only for share-with-stakeholders previews.
PREVIEW_LOGIN_ALLOWED_EMAILS=""

# --- AI (optional) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Attachments ---
# Leave S3_* empty to use local filesystem (./var/uploads) in dev.
S3_ENDPOINT=""
S3_REGION="eu-west-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
