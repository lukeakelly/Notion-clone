// Software Project Estimation Tool — Prisma schema (MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- Auth (Auth.js) --------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("editor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  estimates     Estimate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------- Estimation Models --------------------

model Estimate {
  id              String   @id @default(cuid())
  projectName     String
  clientName      String
  industry        String?
  projectType     String
  estimateType    String   @default("rom")
  status          String   @default("draft")
  version         Int      @default(1)
  currency        String   @default("AUD")
  targetDate      DateTime?
  deliveryModel   String?
  methodology     String?

  // Complexity multiplier settings
  requirementsClarity    String @default("clear")
  designMaturity         String @default("existing")
  integrationFamiliarity String @default("known")
  regulatoryComplexity   String @default("standard")
  securityComplexity     String @default("standard")
  performanceNeeds       String @default("standard")
  techStackFamiliarity   String @default("known")

  // Delivery overhead percentages
  pmPercent          Float @default(12.5)
  baPercent          Float @default(15)
  archPercent        Float @default(10)
  qaPercent          Float @default(25)
  devopsPercent      Float @default(10)
  securityPercent    Float @default(7.5)
  docPercent         Float @default(7.5)
  contingencyPercent Float @default(20)

  // Scope selection flags
  includesFrontEnd       Boolean @default(false)
  includesBackEnd        Boolean @default(false)
  includesFullStack      Boolean @default(false)
  includesApiIntegration Boolean @default(false)
  includesDataLayer      Boolean @default(false)
  includesAuth           Boolean @default(false)
  includesAdminConsole   Boolean @default(false)
  includesReporting      Boolean @default(false)
  includesWorkflowEngine Boolean @default(false)
  includesAiCapability   Boolean @default(false)
  includesThirdParty     Boolean @default(false)
  includesDevOps         Boolean @default(false)
  includesMaintenance    Boolean @default(false)

  // Questionnaire responses stored as JSON
  questionnaireData Json?

  // Calculated totals (cached)
  totalLowDays    Float?
  totalLikelyDays Float?
  totalHighDays   Float?
  totalLowCost    Float?
  totalLikelyCost Float?
  totalHighCost   Float?
  confidenceLevel String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateCardId String?
  rateCard   RateCard? @relation(fields: [rateCardId], references: [id])

  scopeItems     ScopeItem[]
  roleEstimates  RoleEstimate[]
  risks          Risk[]
  assumptions    Assumption[]
  versions       EstimateVersion[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model ScopeItem {
  id           String   @id @default(cuid())
  estimateId   String
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  category     String
  priority     String   @default("must")
  complexity   String   @default("medium")
  effortDriver String?
  lowEffort    Float?
  likelyEffort Float?
  highEffort   Float?
  assumptions  String?
  exclusions   String?
  risks        String?
  confidence   String?
  overridden   Boolean  @default(false)
  overrideNote String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([estimateId])
}

model RoleEstimate {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  role       String
  days       Float
  rate       Float
  cost       Float
  phase      String?
  workstream String?

  @@index([estimateId])
}

model Risk {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String
  impact      String   @default("medium")
  likelihood  String   @default("medium")
  mitigation  String?
  owner       String?
  createdAt   DateTime @default(now())

  @@index([estimateId])
}

model Assumption {
  id               String   @id @default(cuid())
  estimateId       String
  estimate         Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description      String
  relatedScopeItem String?
  status           String   @default("active")
  createdAt        DateTime @default(now())

  @@index([estimateId])
}

model EstimateVersion {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  changeNote String?
  createdAt  DateTime @default(now())

  @@index([estimateId])
}

model RateCard {
  id          String         @id @default(cuid())
  name        String
  description String?
  currency    String         @default("AUD")
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  roles     RateCardRole[]
  estimates Estimate[]
}

model RateCardRole {
  id           String   @id @default(cuid())
  rateCardId   String
  rateCard     RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  role         String
  standardRate Float
  costRate     Float?
  margin       Float?
  location     String?
  seniority    String?

  @@index([rateCardId])
}
